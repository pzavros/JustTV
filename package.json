{
  "name": "justtv",
  "version": "2.1.0",
  "private": true,
  "description": "JustTV developer sources and local-only verification tools",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "verify": "npm run build && npm run check && npm test && npm run test:browser",
    "check:equivalence": "node scripts/check.mjs --equivalence",
    "format": "prettier --write \"src/**/*.{js,css,ts,html}\" \"scripts/*.mjs\" \"tests/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,css,ts,html}\" \"scripts/*.mjs\" \"tests/*.mjs\"",
    "preview": "node scripts/preview.mjs",
    "test:performance": "node scripts/performance.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "css-tree": "3.2.1",
    "html-minifier-terser": "7.2.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "terser": "5.51.2"
  }
}
